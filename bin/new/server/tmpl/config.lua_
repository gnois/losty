-- {env} is replaced by gen.lua (called from run.sh/run.bat dev|prod)

assert('dev' == '{env}' or 'prod' == '{env}', "env must be 'dev' or 'prod'")
local specs = {
    dev = {
        secret = '@@APP_NAME@@-dev-secret-change-me'
    }
    , prod = {
        -- Change before deploying. Do NOT commit real secrets.
        secret = '@@APP_NAME@@-prod-secret-change-me!'
    }
}

local spec = specs['{env}'] or specs.dev
spec.env = '{env}'

return spec

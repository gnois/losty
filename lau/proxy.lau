var bit = require('bit')
var to = require('losty.to')

var lower = string.lower

var split_quoted = \txt, sep ->
	var out = {}
	if not txt
		return out
	var q = false
	var esc = false
	var acc = {}
	for i = 1, #txt
		var c = string.sub(txt, i, i)
		if esc
			acc[#acc + 1] = c
			esc = false
		else if c == '\\' and q
			esc = true
		else if c == '"'
			q = not q
			acc[#acc + 1] = c
		else if c == sep and not q
			out[#out + 1] = to.trim(table.concat(acc, ''))
			acc = {}
		else
			acc[#acc + 1] = c
	out[#out + 1] = to.trim(table.concat(acc, ''))
	return out

var unquote = \v ->
	if not v
		return v
	if string.sub(v, 1, 1) == '"' and string.sub(v, -1, -1) == '"'
		v = string.sub(v, 2, -2)
	return v

-- RFC 7239 Forwarded parser
-- returns array of elements, each is key/value table (lowercased keys)
var parse_forwarded = \header ->
	var out = {}
	for _, elem in ipairs(split_quoted(header, ','))
		if #elem > 0
			var e = {}
			for _, part in ipairs(split_quoted(elem, ';'))
				var k, v = string.match(part, '^%s*([^=]+)%s*=%s*(.-)%s*$')
				if k and v
					e[lower(to.trim(k))] = unquote(to.trim(v))
			if next(e)
				out[#out + 1] = e
	return out

var ipv4_u32 = \ip ->
	var a, b, c, d = string.match(ip or '', '^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
	if not a
		return nil
	a = tonumber(a)
	b = tonumber(b)
	c = tonumber(c)
	d = tonumber(d)
	if a > 255 or b > 255 or c > 255 or d > 255
		return nil
	return bit.bor(bit.lshift(a, 24), bit.lshift(b, 16), bit.lshift(c, 8), d)

-- IPv6 address -> eight 16-bit words, or nil when malformed. Handles '::'
-- compression and an embedded IPv4 tail (e.g. ::ffff:192.0.2.1).
var hex16 = \s ->
	if #s < 1 or #s > 4 or string.find(s, '[^0-9a-fA-F]')
		return nil
	return tonumber(s, 16)

-- one side of a '::' split: a colon-separated run of hex groups whose last
-- group may be a dotted quad. rejects empty, doubled or stray colons.
var v6_part = \txt ->
	var out = {}
	if txt == ''
		return out
	var groups = {}
	for g in string.gmatch(txt, '[^:]+')
		groups[#groups + 1] = g
	-- a well-formed run is exactly its groups rejoined with single colons
	if table.concat(groups, ':') ~= txt
		return nil
	for i = 1, #groups
		var g = groups[i]
		if string.find(g, '.', 1, true)
			if i ~= #groups  -- a dotted quad is only valid as the final group
				return nil
			var n = ipv4_u32(g)
			if not n
				return nil
			out[#out + 1] = bit.rshift(n, 16)
			out[#out + 1] = bit.band(n, 0xffff)
		else
			var w = hex16(g)
			if w == nil
				return nil
			out[#out + 1] = w
	return out

var ipv6_words = \ip ->
	var s = ip
	if not s
		return nil
	if string.sub(s, 1, 1) == '['
		s = string.match(s, '^%[([^%]]+)%]') or s
	if not string.find(s, ':', 1, true) or string.find(s, '[^0-9a-fA-F:%.]')
		return nil
	var at = string.find(s, '::', 1, true)
	var left, right = s, nil
	if at
		left = string.sub(s, 1, at - 1)
		right = string.sub(s, at + 2)
		if string.find(right, '::', 1, true)
			return nil
	var words = v6_part(left)
	if not words
		return nil
	if right
		var tail = v6_part(right)
		if not tail
			return nil
		var fill = 8 - #words - #tail
		if fill < 1  -- '::' stands for at least one group of zeroes
			return nil
		for _ = 1, fill
			words[#words + 1] = 0
		for _, w in ipairs(tail)
			words[#words + 1] = w
	if #words ~= 8
		return nil
	return words

-- does an 8-word IPv6 address fall inside a parsed IPv6 rule?
var v6_match = \words, rule ->
	for i = 1, 8
		var bits = rule.p - (i - 1) * 16
		if bits > 0
			var m
			if bits >= 16
				m = 0xffff
			else
				m = bit.band(0xffff, bit.lshift(0xffff, 16 - bits))
			if bit.band(words[i], m) ~= rule.base[i]
				return false
	return true

var cidr_rule = \txt ->
	var ip, p = string.match(txt or '', '^([^/]+)/(%d+)$')
	if not ip
		return nil
	p = tonumber(p)
	if string.find(ip, ':', 1, true)
		var words = ipv6_words(ip)
		if not words or p < 0 or p > 128
			return nil
		var v6base = {}
		for i = 1, 8
			var bits = p - (i - 1) * 16
			if bits <= 0
				v6base[i] = 0
			else if bits >= 16
				v6base[i] = words[i]
			else
				v6base[i] = bit.band(words[i], bit.band(0xffff, bit.lshift(0xffff, 16 - bits)))
		return {v6 = true, base = v6base, p = p}
	var v4base = ipv4_u32(ip)
	if not v4base
		return nil
	if p < 0 or p > 32
		return nil
	var mask
	if p == 0
		mask = 0
	else
		mask = bit.tobit(bit.lshift(0xffffffff, 32 - p))
	return {base = bit.band(v4base, mask), mask = mask}

var trustfn = \trusted ->
	if not trusted
		return nil
	if type(trusted) == 'function'
		return trusted
	if type(trusted) ~= 'table'
		error('trusted must be function or array of IP/CIDR strings', 2)

	var exact = {}
	var rules = {}
	for _, v in ipairs(trusted)
		if v
			v = to.trim(v)
			var rule = cidr_rule(v)
			if not rule and string.find(v, ':', 1, true)
				-- a bare IPv6 literal is a /128, so every legal spelling of the
				-- same address compares equal instead of by raw string
				rule = cidr_rule(v .. '/128')
			if rule
				rules[#rules + 1] = rule
			else
				exact[lower(v)] = true

	return \ip ->
		if ip and exact[lower(ip)]
			return true
		if ip
			var v4 = ipv4_u32(ip)
			if v4
				for _, rule in ipairs(rules)
					if not rule.v6 and bit.band(v4, rule.mask) == rule.base
						return true
			else if string.find(ip, ':', 1, true)
				var words = ipv6_words(ip)
				if words
					for _, rule in ipairs(rules)
						if rule.v6 and v6_match(words, rule)
							return true
		return false

var is_ipv6_literal = \txt ->
	if not txt or not string.find(txt, ':', 1, true)
		return false
	if string.find(txt, '[^0-9a-fA-F:%.]')
		return false
	return true


var normalize_ip = \raw ->
	if raw
		var ip = to.trim(raw)
		if ip == '' or ip == 'unknown' or string.sub(ip, 1, 1) == '_'
			return nil
		ip = string.gsub(ip, '^"(.*)"$', '%1')

		if string.sub(ip, 1, 1) == '['
			var host = string.match(ip, '^%[([^%]]+)%]')
			if host and host ~= ''
				if is_ipv6_literal(host)
					return lower(host)
			return nil

		var a, b, c, d, p = string.match(ip, '^(%d+)%.(%d+)%.(%d+)%.(%d+):(%d+)$')
		if a
			ip = a .. '.' .. b .. '.' .. c .. '.' .. d

		if ipv4_u32(ip)
			return ip
		if is_ipv6_literal(ip)
			return lower(ip)


var forwarded_chain = \header ->
	var chain = {}
	for _, e in ipairs(parse_forwarded(header))
		var f = normalize_ip(e['for'])
		if f
			chain[#chain + 1] = f
	return chain

var xff_chain = \header ->
	var chain = {}
	for ip in string.gmatch(header or '', '[^,]+')
		ip = normalize_ip(ip)
		if ip
			chain[#chain + 1] = ip
	return chain

var first = \csv ->
	if csv
		var x = string.match(csv, '^%s*([^,]+)')
		return x and to.trim(x)

var normalize_scheme = \raw ->
	if raw
		var s = lower(to.trim(raw))
		if s == 'http' or s == 'https'
			return s

var normalize_host = \raw ->
	if raw
		var h = to.trim(string.gsub(raw, '^"(.*)"$', '%1'))
		if h == '' or string.find(h, '[%s/%?#@]') or string.find(h, '[^%w%.%-%[%]:]')
			return nil
		return lower(h)

var fallback_host = \vars, remote ->
	var host = normalize_host(vars and vars.host)
	if host
		return host
	var ip = normalize_ip(remote)
	if ip
		if string.find(ip, ':', 1, true)
			return '[' .. ip .. ']'
		return ip
	return 'localhost'

var client_ip = \vars, trusted ->
	var remote = vars.remote_addr
	var is_trusted = trustfn(trusted)
	if not is_trusted or not is_trusted(remote)
		return remote

	var chain = forwarded_chain(vars.http_forwarded)
	if #chain < 1
		chain = xff_chain(vars.http_x_forwarded_for)
	chain[#chain + 1] = remote

	for i = #chain, 1, -1
		var ip = chain[i]
		if ip and not is_trusted(ip)
			return ip
	return remote

var canonical_url = \q, trusted ->
	var vars = q.vars
	var headers = q.headers
	var remote = vars.remote_addr
	var is_trusted = trustfn(trusted)
	var trusted_remote = is_trusted and is_trusted(remote)

	var fwd = trusted_remote and parse_forwarded(vars.http_forwarded) or {}
	var f0 = fwd[1] or {}

	var scheme = nil
	if trusted_remote
		scheme = normalize_scheme(f0['proto']) or normalize_scheme(first(vars.http_x_forwarded_proto))
	if not scheme
		scheme = q.secure() and 'https' or 'http'

	var host = nil
	if trusted_remote
		host = normalize_host(f0['host']) or normalize_host(first(vars.http_x_forwarded_host))
	if not host
		host = normalize_host(headers['Host']) or fallback_host(vars, remote)

	var uri = vars.request_uri or vars.uri or '/'
	if string.sub(uri, 1, 1) ~= '/'
		uri = '/' .. uri

	return scheme .. '://' .. host .. uri

return {
	parse_forwarded = parse_forwarded
	, trustfn = trustfn
	, client_ip = client_ip
	, canonical_url = canonical_url
}

-- pure JSON string helpers, no ngx: used by web.lau, and unit-testable with
-- plain luajit


-- true when ctype is application/json or application/*+json (params ignored)
var is_json = \ctype ->
	if not ctype
		return false
	var ct = string.match(string.lower(ctype), '^[^;]*') or ctype
	ct = string.match(ct, '^%s*(.-)%s*$')
	if ct == 'application/json'
		return true
	return string.match(ct, '^application/[%w%._%-]+%+json$') ~= nil


-- re-indent compact JSON for a human reader. a string-aware scan, so commas,
-- braces and colons inside string literals are never touched
var pretty = \txt, space ->
	var ind = string.rep(' ', space or 2)
	var out = {}
	var depth = 0
	var in_str = false
	var esc = false
	var i, n = 1, #txt
	while i <= n
		var c = string.sub(txt, i, i)
		if in_str
			out[#out + 1] = c
			if esc
				esc = false
			else if c == '\\'
				esc = true
			else if c == '"'
				in_str = false
		else if c == '"'
			in_str = true
			out[#out + 1] = c
		else if c == '{' or c == '['
			if string.sub(txt, i + 1, i + 1) == (c == '{' and '}' or ']')
				-- empty object/array stays on one line
				out[#out + 1] = c .. string.sub(txt, i + 1, i + 1)
				i = i + 1
			else
				depth = depth + 1
				out[#out + 1] = c
				out[#out + 1] = '\n'
				out[#out + 1] = string.rep(ind, depth)
		else if c == '}' or c == ']'
			depth = depth - 1
			out[#out + 1] = '\n'
			out[#out + 1] = string.rep(ind, depth)
			out[#out + 1] = c
		else if c == ','
			out[#out + 1] = ',\n'
			out[#out + 1] = string.rep(ind, depth)
		else if c == ':'
			out[#out + 1] = ': '
		else if c == ' ' or c == '\t' or c == '\n' or c == '\r'
			-- drop insignificant whitespace outside a string
		else
			out[#out + 1] = c
		i = i + 1
	return table.concat(out, '')


return {
	is_json = is_json
	, pretty = pretty
}

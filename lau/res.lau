-- a response helper: status, headers, cookies, and request-scoped cleanup

var cjson = require('cjson')
var hdr = require('losty.header')


--`` unused, ngx lua will do this
-- capitalize word, t.foo_bar becomes t['Foo-Bar']
var capitalize = \txt ->
	if txt
		return string.lower(txt).gsub(@, "^%l", string.upper).gsub(@, "-%l", string.upper)
``

-- setting headers before ngx.exec() has no effect on subrequest
var exec = \uri, args ->
	if not uri
		error("uri required", 2)
	return {
		__ngx_exec = true
		, uri = uri
		, args = args
	}

-- see http://www.nczonline.net/blog/2009/05/05/http-cookies-explained/ section 'Cookie maintenance and lifecycle'
-- https://cheatsheetseries.owasp.org/cheatsheets/Session_Management_Cheat_Sheet.html

-- a cookie has identity: name, domain, path and httponly
-- it cannot be deleted from browser if any of these mismatch
-- domain shd be nil, to exclude subdomain. if specified, subdomains are always included
-- https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie
return ->
	-- per-response cookie state (must not be shared across requests)
	var jar = {}
	var order, o = {}, 0

	-- reject ; and control characters: these go verbatim into Set-Cookie, so
	-- they could inject attributes or extra headers. the cookie *value* needs
	-- no check, bake() uri-escapes it
	var unsafe = \txt ->
		if not txt
			return false
		return string.match(txt, "[%c;]") ~= nil

	var cookie = \name, httponly, domain, path ->
		if not name or string.match(name, "[%c;=,%s\"]")
			error("cookie name must be a http token (RFC 6265)", 2)
		if unsafe(domain) or unsafe(path)
			error("cookie domain/path must not contain ';' or control characters", 2)

		var c = {
			_name = name
			, _httponly = httponly
			, _domain = domain
			, _path = path
		}

		var data = setmetatable({}, {
			__metatable = false
			-- expose attributes
			, __index = c

			-- non identity, not needed for delete cookie: age, samesite, secure
			-- age in secs, nil means last till browser close, -ve means delete
			-- samesite can be bool or string [lax|strict|none]. true=strict, false=none, nil means samesite not set (defaults to 'lax' by browser)
			-- secure is bool, use req.secure()
			-- value can be nil, string or function.
			--   nil + keys set on data table -> auto JSON-encoded
			--   nil + no keys set -> empty string
			--   if string, taken as is (keys set on data are ignored)
			--   if function, called with data table as argument
			, __call = \t, age, samesite, secure, value ->
				c._age = age
				c._samesite = samesite
				c._secure = secure
				c._value = value
				return t
		})

		if jar[name]
			ngx.log(ngx.NOTICE, "Overwriting cookie " .. name)
		else
			o = o + 1
			order[o] = name

		jar[name] = data
		return data

	var bake = \c ->
		var val = c._value
		if val
			if 'function' == type(val)
				val = val(c)
		else if next(c) ~= nil  -- raw keys on data table -> auto JSON
			val = cjson.encode(c)
		val = val and ngx.escape_uri(tostring(val)) or ""

		var z = { c._name .. "=" .. val }
		var y = 2

		if c._domain
			z[y] = "Domain=" .. c._domain
			y = y + 1
		if c._path
			z[y] = "Path=" .. c._path
			y = y + 1
		var a = tonumber(c._age)
		if a
			if a ~= 0
				z[y] = "Expires=" .. ngx.cookie_time(ngx.time() + a)
				y = y + 1
			-- Max-Age cannot be zero or -ve
			if a > 0
				z[y] = "Max-Age=" .. a
				y = y + 1
		var ss = c._samesite
		var secure = c._secure
		if ss ~= nil
			if 'boolean' == type(ss)
				ss = ss and "strict" or "none"
			else
				ss = string.lower(ss)
			if unsafe(ss)
				error("cookie samesite must not contain ';' or control characters", 2)
			z[y] = "SameSite=" .. ss
			y = y + 1
			if ss == "none"
				secure = true
		if c._httponly
			z[y] = "HttpOnly"
			y = y + 1
		if secure
			z[y] = "Secure"

		return table.concat(z, ";")

	var send = ->
		var arr = {}
		if o > 0
			for n, k in ipairs(order)
				arr[n] = bake(jar[k])
			hdr.headers['Set-Cookie'] = arr
		return ngx.send_headers()

	-- registered by handlers, run once, LIFO, before the response is sent.
	var hooks = {}
	var defer = \fn, ... ->
		if 'function' ~= type(fn)
			error("r.defer requires function", 2)
		var np = select('#', ...)
		if np == 0
			table.insert(hooks, fn)
		else
			var args = {...}
			table.insert(hooks, ->
				return fn(unpack(args, 1, np))
			)

	-- called by run() after the chain returns,
	-- including on the 500 path.
	var run_defers = ->
		if #hooks == 0
			return
		-- swap the list out first so a second call is a no-op: a hook can never
		-- run twice, even if run() is re-entered by an internal redirect
		var running = hooks
		hooks = {}
		for i = #running, 1, -1
			var ok, err = xpcall(running[i], \trace ->
				return debug.traceback(trace, 2)
			)
			if not ok
				ngx.log(ngx.ERR, err)

	var cookies = setmetatable({}, {
		__index = jar
		, __newindex = ->
			error("use response.cookie() to update response cookies", 2)
	})

	return setmetatable({
		headers = hdr.headers
		, nocache = hdr.nocache
		, cache = hdr.cache
		, vary = hdr.vary
		, cookie = cookie
		, cookies = cookies
		, redirect = hdr.redirect
		, exec = exec
		, defer = defer
		, run_defers = run_defers
		, send = send

	}, {
		__metatable = false

		, __index = \_, k ->
			if 'status' == k
				return ngx.status

		, __newindex = \t, k, v ->
			if 'status' == k
				ngx.status = v
			else
				-- keep per-request fields (eg res.user) instead of dropping them
				-- silently, as req() already allows
				rawset(t, k, v)
	})

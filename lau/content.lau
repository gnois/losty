var cjson = require('cjson')
var body = require('losty.body')
var accept = require('losty.accept')
var dispatch = require('losty.dispatch')
var statuses = require('losty.status')

var HTML = "text/html"
var JSON = "application/json"
var PROBLEM = "application/problem+json"


var with_text_charset = \mime ->
	if mime
		var txt = string.lower(mime)
		if string.find(txt, '^text/') and not string.find(txt, ';%s*charset%s*=')
			return mime .. '; charset=utf-8'
	return mime


-- opt-in middleware: set Content-Type explicitly
-- for text/* media types, appends ; charset=utf-8 unless already present
var mime = \kind ->
	var ctype = with_text_charset(kind)
	return \req, res, nxt ->
		res.headers["Content-Type"] = ctype
		return nxt()

var reject = \_, res ->
	res.vary("Accept")
	res.status = ngx.HTTP_NOT_ACCEPTABLE
	-- run() already provides desc for status >= 400


-- See
--   https://www.mnot.net/cache_docs/
--   https://devcenter.heroku.com/articles/jax-rs-http-caching
--   https://devcenter.heroku.com/articles/increasing-application-performance-with-http-cache-headers
var html = \req, res, nxt ->
	var out = nxt()
	res.headers["Content-Type"] = HTML
	-- see nginx_gzip.conf, gzip_vary on;
	-- res.headers["Vary"] = "Accept-Encoding"
	-- browser must not cache html. Else Login then Back button loses the credential
	-- but an explicit Cache-Control from the handler (eg a public page) is kept
	if res.headers["Cache-Control"] == nil
		res.nocache()
	return out


-- sets Content-Type: application/json and continues.
-- The body is encoded by web.lau prepare_body()
var json = mime(JSON)


-- Once a route respond differently based on HTTP Accept header, shd set Vary: Accept for all responses
-- See https://www.fastly.com/blog/best-practices-for-using-the-vary-header
-- This actually causes the browser to not cache the content of all responses
var dual = \... ->
	var inner = {...}
	return \req, res, nxt, ... ->
		-- If we `back` from browser, the json is displayed instead of html page!  We need to have api.domain.com or different url instead of just using content-type
		-- if use vary:Accept header, caching is basically disabled by proxies and browsers
		-- http://www.sitepoint.com/solve-caching-conundrums/
		--   Self signed SSL cert won't see the problem, but problem will appear in production!
		-- http://stackoverflow.com/questions/9956255/chrome-displays-ajax-response-when-pressing-back-button
		-- https://bugs.chromium.org/p/chromium/issues/detail?id=108425
		-- https://bugs.chromium.org/p/chromium/issues/detail?id=94369

		-- See http://stackoverflow.com/questions/1975416/what-is-the-function-of-the-vary-accept-http-header
		-- merge rather than overwrite: cors.lau may have added Origin already
		res.vary("Accept")

		var pref = accept.media(req.headers["Accept"], {HTML, JSON})
		if not pref[1]
			-- nothing in Accept is acceptable, eg `Accept: image/png`
			res.status = ngx.HTTP_NOT_ACCEPTABLE
			return

		if tostring(pref[1]) == HTML
			return dispatch(inner, req, res, ...)
		var outer = {json}
		for i = 2, #inner
			outer[i] = inner[i]
		return dispatch(outer, req, res, ...)


-- RFC 7807 application/problem+json responder (opt-in)
var problem = \req, res, nxt ->
	var out = nxt()
	res.headers["Content-Type"] = PROBLEM
	if type(out) == 'table'
		if out.type == nil
			out.type = 'about:blank'
		var code = tonumber(out.status) or res.status
		if code and code > 0
			if out.status == nil
				out.status = code
			if out.title == nil
				out.title = statuses.text(code)
		out = cjson.encode(out)
	return out



-- form data middleware. max is an optional body limit; nil uses the default
-- (body.MaxBody), a smaller value makes the route answer 413 sooner
var form_limit = \max ->
	return \req, res, nxt ->
		-- val is an iterator function for multipart/form-data
		var val, reason, detail = body.prepare(req, max)
		if val or 'DELETE' == req.vars.request_method
			return nxt(val)
		-- http://stackoverflow.com/questions/7323958/are-put-and-post-requests-required-expected-to-have-a-request-body
		-- js client should not PUT or POST without a body
		if reason == "too_large"
			res.status = ngx.HTTP_REQUEST_ENTITY_TOO_LARGE
			return {fail = "request body too large"}
		if reason == "unsupported"
			res.status = ngx.HTTP_UNSUPPORTED_MEDIA_TYPE
			return {fail = "unsupported content-type " .. (detail or "")}
		res.status = ngx.HTTP_BAD_REQUEST
		return {fail = reason or "no request body"}


return {
	-- form uses the default body limit; form_limit(max) sets a smaller one
	form = form_limit(nil)
	, form_limit = form_limit
	, reject = reject
	, mime = mime
	, text = \kind ->
		return mime(kind or 'text/plain')
	, html = html
	, json = json
	, problem = problem
	-- url generates text/html and application/json response depending on Accept headers
	-- reject is still returned for chains that expect it, but dual() now answers 406 itself
	, dual = \... ->
		return dual(html, ...), reject
}

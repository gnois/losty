var router = require('losty.router')
var dispatch = require('losty.dispatch')
var statuses = require('losty.status')
var req = require('losty.req')
var res = require('losty.res')
var etag = require('losty.etag')
var json = require('losty.json')
var cjson = require('cjson.safe')

var METHODS = {'GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'OPTIONS'} -- 'TRACE', 'CONNECT'

var send_body = \body ->
	if type(body) == 'function'
		while true
			var chunk = body()
			if chunk == nil
				return true
			var ok, err = ngx.print(chunk)
			if ok
				ok, err = ngx.flush(true)
			if not ok
				return ok, err
	return ngx.print(body)


-- auto-detect response type from body
--   string/number -> sent as-is (caller sets Content-Type if desired)
--   function      -> streaming iterator (handled in send_body)
--   table         -> JSON-encoded (empty tables and arrays included)
--   when the client asked (?pretty) a JSON table body is re-indented
var prepare_body = \r, body ->
	if type(body) == 'table'
		var encoded, err = cjson.encode(body)
		if not encoded
			error("response body is not JSON-encodable: " .. tostring(err), 2)
		var ctype = r.headers['Content-Type']
		if ctype == nil -- may have application/ld+json, application/vnd.api+json
			ctype = 'application/json'
			r.headers['Content-Type'] = ctype
		if r.pretty and json.is_json(ctype)
			encoded = json.pretty(encoded, 2)
		return encoded
	return body


var has_body = \body ->
	if body == nil or (type(body) == 'string' and body == '')
		return false
	return true


-- constant xpcall handler, hoisted so a request only allocates the protected call
var trace_err = \err ->
	return debug.traceback(err, 2)


-- prepend base to path (nil and '/' mean no prefix)
var prefixed = \base, path ->
	if base and base ~= '/'
		return base .. path
	return path


-- verbs that register into rt. the phase check lives here, not on new.
-- an app is pure data, but registration must happen in init_by_lua_block so the tree is
-- built once and inherited by every worker
var registrar = \rt, base, name ->
	var r = {}
	for _, meth in ipairs(METHODS)
		r[string.lower(meth)] = \path, f, ... ->
			var phase = ngx.get_phase()
			if phase ~= 'init'
				error("route must be declared in init_by_lua_block, not '" .. phase .. "' phase (app '" .. (name or 'unnamed') .. "')", 2)
			rt.set(meth, prefixed(base, path), f, ...)
	return r


-- show the error_page if status >= 400, error_page = true and body = nil
-- check: true to check if status and content-type header exists
-- returns
--  truthy or nil/false, err
var run = \rt, name, error_page, check ->
	var handlers, body, ok, trace
	var q = req()
	var r = res()

	-- allow user-owned per-request data
	q.state = {}

	var method = q.vars.request_method
	handlers, q.match = rt.match(method == 'HEAD' and 'GET' or method, q.vars.uri)
	-- on a miss rt.match returns the reason string in place of the captures
	if not handlers
		q.match = {}
	if handlers
		ok, trace = xpcall(->
			body = dispatch(handlers, q, r)
		, trace_err)
		if not ok
			r.status = 500
			ngx.log(ngx.ERR, (name and ("[" .. name .. "] ") or "") .. trace)
	else
		-- path registered under another method -> 405 with Allow, else 404
		var allow = rt.allowed(method, q.vars.uri)
		if allow
			r.status = 405
			r.headers['Allow'] = table.concat(allow, ', ')
		else
			r.status = 404

	r.run_defers()

	-- opt-in: r.metric / r.start / r.stop recorded Server-Timing metrics
	var timing = r.server_timing()
	if timing
		r.headers['Server-Timing'] = timing

	body = prepare_body(r, body)

	-- may set a 304 status and drop the body when the client copy is current
	body = etag.check(q, r, body)

	var code = r.status
	if error_page == true and code >= 400 and not has_body(body)
		-- https://github.com/openresty/lua-nginx-module/issues/875
		-- doc: for error_page to work, you must not generate and send your own response via the ngx.status and ngx.say/ngx.print API
		-- for 408, even error_page will not be sent
		return ngx.exit(code)

	-- cache to avoid calling is_empty(code) twice below
	var empty = statuses.is_empty(code)

	if check
		if code == 0 -- ngx.status defaults to 0
			error("Response status required")

		if statuses.is_redirect(code) and r.headers['Location'] == nil
			error("Location header required for redirect status")

		-- status < 200 or >= 300 can have no content, so no content-type needed
		if body ~= nil or (code >= 200 and code < 300)
			if not empty and r.headers['Content-Type'] == nil
				error("Content-Type header required")

	var err
	ok, err = r.send() -- send cookies and headers
	if not ok
		-- the headers never reached the wire: a real failure (a bad header value,
		-- or headers already sent by an earlier ngx.print in the chain)
		ngx.log(ngx.ERR, (name and ("[" .. name .. "] ") or "") .. "cannot send headers: " .. tostring(err))
		-- caller to check err/trace is not nil
		return code, err or trace

	if method ~= 'HEAD' and not empty and body ~= nil
		ok, err = send_body(body)
	if ok
		ok, err = ngx.eof()
	if not ok
		-- the headers are already out, so the only failure left is the client
		-- hanging up mid-response, which is routine under load and would
		-- otherwise flood error.log
		-- https://github.com/openresty/lua-nginx-module#ngxprint
		ngx.log(ngx.WARN, (name and ("[" .. name .. "] ") or "") .. "cannot send body: " .. tostring(err))
	-- caller to check err/trace is not nil
	return code, err or trace


-- an app owns a router plus the verbs and run() that use it. name is for
-- diagnostics only: the registration-phase error and the 500 log line
var new = \name ->
	var rt = router()
	var app = registrar(rt, nil, name)
	app.name = name
	app.route = \prefix -> return registrar(rt, prefix, name)
	app.run = \error_page, check -> return run(rt, name, error_page, check)
	return app


return {
	new = new
}

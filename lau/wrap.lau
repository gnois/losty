var enc = require('losty.enc')
var sigurl = require('losty.sigurl')

-- data and key is optionally encrypted

return \secret, key, length ->
	if not (secret and key)
		error("secret and key required", 2)

	var pen = sigurl(secret, length)

	return {
		-- encryption func optional
		-- returns signature and json encoded key with payload
		wrap = \data, func ->
			var obj = {key = key, data = data}
			var text, err = enc.encode(obj, func)
			if text
				return pen.sign_raw(text), text
			return nil, err

		, unwrap = \sig, text, func ->
			if not text
				return nil, "missing token"
			if not pen.verify_raw(sig, text)
				return nil, "wrong signature"
			var obj, err = enc.decode(text, func)
			if not obj
				return nil, err
			if type(obj) == 'table' and obj.key == key
				return obj.data
			return nil, "wrong key"
	}

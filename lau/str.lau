var bit = require('bit')

-- Returns an array of strings, each of which is a substring of s
-- formed by splitting on boundaries formed by `pattern`.
var split = \str, pattern, plain ->
	var arr = {}
	if pattern and #pattern > 0
		var pos, n = 1, #str
		for st, sp in -> return string.find(str, pattern, pos, plain)
			table.insert(arr, string.sub(str, pos, st-1))
			if sp < st
				-- zero-width match: advance a byte so the loop always progresses
				if st > n
					break
				pos = st + 1
			else
				pos = sp + 1
		table.insert(arr, string.sub(str, pos))
	return arr


var K = {}

-- simple template generation
K.render = \str, data ->
	-- extra parenthesis needed coz string.gsub has multiple returns
	return (string.gsub(str, "{([_%w%.]*)}", \s ->
		var keys = split(s, "%.")
		var v = data[keys[1]]
		for i = 2, #keys
			v = v and v[keys[i]]  -- guard against nil intermediate
		return v or '{'.. s ..'}'
	))

K.safe_equal = \a, b ->
	if not a or not b
		return false
	if #a ~= #b
		return false
	var diff = 0
	for i = 1, #a
		diff = bit.bor(diff, bit.bxor(string.byte(a, i), string.byte(b, i)))
	return diff == 0


K.hash = \str ->
	var hash = 0
	if str
		for c in string.gmatch(str, '.')
			hash = (bit.lshift(hash, 5) - hash) + string.byte(c)
	return hash

-- iterate every character in str
K.each = \str ->
	var p, n = 1, #str
	return ->
		if p <= n
			var c = string.sub(str, p, p)
			p = p + 1
			return p - 1, c

-- Returns true if the string has a match for the plain text (not pattern)
K.contains = \str, part ->
	return string.find(str, part, 1, true) ~= nil

K.starts = \str, part ->
	return string.sub(str, 1, string.len(part)) == part

K.ends = \str, part ->
	return part == '' or string.sub(str, -string.len(part)) == part


K.split = split

-- Same as split but returns iterator instead
K.gsplit = \str, pattern, plain ->
	var pos, n = 1, #str
	var done = false
	return ->
		if done
			return nil
		var st, sp = string.find(str, pattern, pos, plain)
		if not st
			done = true
			return string.sub(str, pos)
		var field = string.sub(str, pos, st-1)
		if sp < st
			-- zero-width match: advance a byte so the iterator always progresses
			if st > n
				done = true
			else
				pos = st + 1
		else
			pos = sp + 1
		return field


-- Find the last instance of a pattern in a string
K.findlast = \str, pattern, plain ->
	var curr = 0
	do
		var nxt = string.find(str, pattern, curr + 1, plain)
		if nxt
			curr = nxt
	until not nxt
	if curr > 0
		return curr

-- Returns the number of lines of text contained by the string.
K.lines = \str ->
	var trailing, n = string.gsub(str, '.-\n', '')
	if #trailing > 0
		n = n + 1
	return n

return K

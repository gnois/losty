var upload = require('resty.upload')
var cjson = require('cjson.safe')
var str = require('losty.str')

var MaxBody = 10 * 1024 * 1024  -- 10MB soft cap

-- byte size of an already-read (possibly file-backed) request body
var body_size = \req ->
	var data = req.get_body_data()
	if data ~= nil
		return #data
	var file = req.get_body_file()
	if file
		var fp = io.open(file, 'r')
		if fp
			var sz = fp.seek(@, "end")
			fp.close(@)
			return sz
	return nil


var raw = \req ->
	var data = req.get_body_data()
	if data ~= nil
		var file = req.get_body_file()
		if file
			var fp, err = io.open(file, 'r')
			if not fp
				return fp, err
			data = fp.read(@, '*a')
			fp.close(@)
	return data


var json = \req ->
	var r, err = raw(req)
	if r
		return cjson.decode(r)
	return r, err



--``
coroutine yields key, val
case key
	string: means header key, val
	true: val is partial body
	false: one body ended, val is nil
	nil: all body ended. val is err or nil
--``

var yield = coroutine.yield

var content_disposition = \value ->
	var dtype, params = string.match(value, '([%w%-%._]+);(.+)')
	if dtype and params
		var out, o = {}, 0
		for param in str.gsplit(params, ';')
			var key, val = string.match(param, '([%w%.%-_]+)="(.+)"$')
			if key
				o = o + 1
				out[o] = {key, val}
		return out


-- stream limit; nil/absent means the MaxBody soft cap
var cap = \mmt -> return mmt and mmt > 0 and mmt or MaxBody

var parser = \max ->
	var input, err = upload.new(@, 4096)
	if input
		input.set_timeout(@, 8000) -- 8 sec
		var t, data
		var used = 0
		var limit = cap(max)
		do
			t, data, err = input.read(@)
			if t
				if 'header' == t
					var name, value = unpack(data)
					if name == 'Content-Disposition'
						var params = content_disposition(value)
						if params
							for _, v in ipairs(params)
								yield(v[1], v[2])
					else
						yield(string.lower(name), value)
				else if 'body' == t
					used = used + #data
					if used > limit
						err = "request body too large"
						break
					yield(true, data)
				else if 'part_end' == t
					yield(false, nil)
			else
				err = err or "fail to parse upload data"
		until not t or t == 'eof'
	return nil, err




return {
	raw = \req ->
		req.read_body()
		return raw(req)


	-- chunked encoding
	-- https://github.com/openresty/lua-nginx-module/blob/master/t/116-raw-req-socket.t

	-- http://stackoverflow.com/questions/18877778/how-to-inspect-post-body-in-nginx-httpluamodule/19060711#19060711
	-- buffered way
	-- only for HTTP 1.x
	-- The limit defaults to MaxBody and applies to every body parser, not just
	-- multipart. A declared Content-Length that already exceeds the limit is
	-- refused before the body is read (fast path). For chunked transfer there
	-- is no Content-Length, so the size is checked after buffering.
	, prepare = \req, max ->
		var limit = cap(max)
		var len = tonumber(req.headers["Content-Length"])
		if len and len > limit
			return nil, "too_large", len
		if req.headers["Transfer-Encoding"] or req.headers["Content-Length"]
			req.read_body()
			var size = body_size(req)
			if size and size > limit
				return nil, "too_large", size
			var ctype = req.headers["Content-Type"]
			if ctype
				-- normalize the media type: strip parameters, trim, lowercase
				var base = string.match(ctype, "^%s*([^;]+)")
				if base
					base = string.lower(string.match(base, "^%s*(.-)%s*$"))
					if base == "application/x-www-form-urlencoded"
						return req.get_post_args()
					if base == "application/octet-stream"
						return raw(req)
					if base == "application/json" or string.match(base, "%+json$")
						return json(req)
					if string.match(base, "^multipart/")
						return ->
							var parse = coroutine.create(parser, max)
							return ->
								var code, key, val = coroutine.resume(parse)
								if not code
									return nil, key
								return key, val
				-- unsupported media type (distinct from missing/empty body)
				return nil, "unsupported", ctype
			return nil, "missing content-type"
		return false, "possibly empty request body"

}

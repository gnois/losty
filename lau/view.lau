var tbl = require('losty.tbl')
var set = require('losty.set')
var concat = table.concat
var remove = table.remove
var insert = table.insert
var yield = coroutine.yield
var create = coroutine.create
var resume = coroutine.resume
var gmatch = string.gmatch
var gsub = string.gsub
var match = string.match
var sort = table.sort
var find = string.find

-- Escaping map for gsub's table form: one pass with one lookup per special
-- char, instead of one whole-string pass per char.
var esc_map = {
	'&' = '&amp;'
	, '<' = '&lt;'
	, '>' = '&gt;'
	, '"' = '&quot;'
	, "'" = '&#39;'
}
var esc_text = '[&<>]'
var esc_quote = "[&<>\"']"

var esc = \txt, quote ->
	if nil == txt
		return ''
	txt = tostring(txt)
	-- quotes are only special inside an attribute value
	var pattern = esc_text
	if quote
		pattern = esc_quote
	-- most text has nothing to escape: one scan, no allocation
	if nil == find(txt, pattern)
		return txt
	var out = gsub(txt, pattern, esc_map)
	return out
--
-- _G.table and _G.select are masked by html tag of the same name
--   select has no replacement
--   Use concat, insert and remove without qualifying table
--
var void_tags = set(
	'area'
	, 'base'
	, 'br'
	, 'col'
	, 'command'
	, 'embed'
	, 'hr'
	, 'img'
	, 'input'
	, 'keygen'
	, 'link'
	, 'meta'
	, 'param'
	, 'source'
	, 'track'
	, 'wbr'
)

var parse = \s ->
	var r = create( ->
		var acc, n = {}, 1
		for c in gmatch(s, '.')
			if c == '.' or c == '#' or c == '['
				-- dont yield if still in bracket
				if acc[1] == '['
					acc[n] = c --insert(acc, c)
					n = n + 1
				else
					if acc[1]
						yield(acc)
					acc = {c}
					n = 2
			else --if c ~= ' '  -- meta description needs the space
				acc[n] = c --insert(acc, c)
				n = n + 1
				if c == ']'
					--if #acc > 2
					if n > 3
						yield(acc)
					acc = {}
					n = 1
		if acc[1]
			yield(acc)
	)
	return ->
		var code, res = resume(r)
		return res


var NoChild = \tag ->
	return "<" .. tag .. "> cannot have child element"


-- void tag
var void = \tag, attrs ->
	var cell = {_tag = tag, attrs = {}}
	var classes, n = {}, 1
	if nil ~= attrs
		var kind = type(attrs)
		if 'string' == kind
			for v in parse(attrs)
				if v[1] == '#'
					cell.attrs.id = concat(v, '', 2)
				else if v[1] == '.'
					classes[n] = concat(v, '', 2) --insert(classes, concat(v, '', 2))
					n = n + 1
				else if v[1] == '['
					var i = tbl.find(v, '=')
					var key, val
					if i
						key = concat(v, '', 2, i-1)
						val = concat(v, '', i+1, #v-1)
						val = gsub(val, "['\"](%w+)['\"]", '%1')
					else
						key = concat(v, '', 2, #v-1)
						val = true
					cell.attrs[key] = val
				else
					var msg = tag .. "('" .. concat(v) .. "'"
					error(msg .. " attribute must start with `.` or `#` or `[`", 2)

		else if 'table' == kind
			-- attr cannot be array
			if attrs[1]
				error(NoChild(tag), 2)

			for key, val in pairs(attrs)
				-- attr cannot have {_tag=...}
				if key == '_tag'
					error(NoChild(tag), 2)
				if key == 'class'
					if val ~= nil and val ~= ''
						classes[n] = val --insert(classes, val)
						n = n + 1
				else
					cell.attrs[key] = val
		else
			var msg = tag .. '(' .. kind .. ')'
			error("Attribute must be a table or a string: " .. msg, 2)

	if classes[1]
		cell.attrs['class'] = concat(classes, ' ')

	return cell

-- normal tag
var normal = \tag, ... ->
	var args = {...}
	var nargs = select('#', ...)
	var attr
	-- count args, not args[2]: a `false` 2nd arg must still make args[1] an attribute
	if nargs > 1
		-- test if possible attr
		var a = args[1]
		var k = type(a)
		if nil == a
			attr = true
		else if 'string' == k
			-- be attr once is a string, and error if string is not empty and not starting with . # [
			-- rather than silenty make it child node on typo
			--`
			attr = #a == 0
			if not attr
				var ch1 = string.sub(a, 1, 1)
				-- or starts with ., # or [
				attr = ch1 == '.' or ch1 == '#' or ch1 == '['
			--`
			attr = true
		else if 'table' == k
			-- attr cannot be array and cannot have key `_tag`
			attr = a[1] == nil and a._tag == nil

	--print('attr', attr)
	var attrib
	if attr
		attrib = args[1]
		-- shift left by hand: remove() uses #args, which is undefined when args[1]
		-- is nil (e.g. strong(nil, 'Home'))
		for i = 1, nargs - 1
			args[i] = args[i + 1]
		args[nargs] = nil

	var cell = void(tag, attrib)
	cell._children = args
	return cell


-- Attribute and element names must be plain HTML names. Without this a dynamic
-- key (e.g. div({[user_key] = 'x'})) could inject extra attributes or tags.
var attr_name = '^[%w_%-:%.]+$'
var tag_name = '^[%w_%-:]+$'

-- Guard against circular node tables / runaway nesting: each html level costs
-- about two frames (a tag, then its children list)
var max_depth = 256


var markup
markup = \nodes, depth ->
	if nil == depth
		depth = 1
	else if depth > max_depth
		error("markup: nesting too deep (circular reference?)", 2)
	if nil ~= nodes
		var o, n = {}, 1
		if 'table' == type(nodes)
			if nodes and nodes._tag
				if 'string' ~= type(nodes._tag) or not match(nodes._tag, tag_name)
					error("Invalid tag name: " .. tostring(nodes._tag), 2)
				o[n] = '<' .. nodes._tag
				n = n + 1
				if nil ~= nodes.attrs
					-- validate names first, then emit sorted, so the same node always
					-- renders to the same bytes (stable across runs and LuaJIT builds)
					var names = {}
					var nn = 0
					for k, v in pairs(nodes.attrs)
						if 'string' ~= type(k) or not match(k, attr_name)
							error("Invalid attribute name: " .. tostring(k), 2)
						if 'table' == type(v) or 'function' == type(v) or 'userdata' == type(v) or 'thread' == type(v)
							error("Invalid value for attribute '" .. k .. "': " .. type(v), 2)
						nn = nn + 1
						names[nn] = k
					sort(names)
					for i = 1, nn
						var key = names[i]
						var val = nodes.attrs[key]
						-- a `false` boolean attribute is absent; `true` is a bare name
						if false ~= val
							o[n] = ' ' .. key
							n = n + 1
							if 'boolean' ~= type(val)
								o[n] = '="' .. esc(val, true) .. '"'
								n = n + 1
				o[n] = '>'
				n = n + 1
				if not void_tags.has(nodes._tag)
					o[n] = markup(nodes._children, depth + 1)
					n = n + 1
					o[n] = '</' .. nodes._tag .. '>'
					n = n + 1
			else
				for _, c in ipairs(nodes)
					o[n] = markup(c, depth + 1)
					n = n + 1
		else
			o[n] = esc(nodes)
			n = n + 1
		return concat(o)
	return ''


-- Globals a view template may reach. Everything else (_G, os, io, require,
-- load/loadstring/loadfile, dofile, debug, package, collectgarbage,
-- setfenv/getfenv, ...) is intentionally unreachable so a template cannot
-- execute commands, read files, or otherwise escape its sandbox.
-- NB: `table` and `select` are deliberately left out so the HTML tags of the
-- same name win; use the unqualified concat/insert/remove instead.
-- Nothing here may yield (no coroutine, ngx, io, socket): view() swaps the
-- template's environment in place and restores it afterwards, which is only
-- re-entrancy-safe while a template cannot suspend mid-render.
var safe_globals = {
	assert = assert
	, error = error
	, getmetatable = getmetatable
	, ipairs = ipairs
	, math = math
	, next = next
	, pairs = pairs
	, pcall = pcall
	, print = print
	, rawequal = rawequal
	, rawget = rawget
	, rawset = rawset
	, setmetatable = setmetatable
	, string = string
	, tonumber = tonumber
	, tostring = tostring
	, type = type
	, unpack = unpack
	, xpcall = xpcall
}


var view = \func, args ->
	var env = {
		concat = concat
		, insert = insert
		, remove = remove
	}
	env = setmetatable(env, {
		__index = \t, name ->
			--print(name)
			if void_tags.has(name)
				return \attrs, w, x, y, z ->
					if w or x or y or z
						error(NoChild(name), 2)
					return void(name, attrs)
			var x = safe_globals[name]
			if nil ~= x
				return x
			return \... ->
				return normal(name, ...)
	})
	-- a C function cannot take an environment; leave it alone rather than raise
	var oldenv
	if 'function' == type(func)
		oldenv = getfenv(func)
		if not pcall(setfenv, func, env)
			oldenv = nil
	var ok, list = xpcall(->
		return func(args)
	, \err ->
		return err
	)
	if nil ~= oldenv
		setfenv(func, oldenv)
	if not ok
		error(list, 2)
	--print(tbl.dump(list))
	var html = markup(list)

	return html  -- caller to prepent '<!DOCTYPE html>



---```
var test = ->
	var v = \fn, a -> return view(fn, a, true)
	var as = assert
	var pr = print

	-- void element
	as(v(-> return br()) == '<br>')
	as(v(-> return br(nil)) == '<br>')  -- attr can be nil
	as(v(-> return br('')) == '<br>')  -- or string
	as(v(-> return br({})) == '<br>') -- or table
	var htm = v(-> return img({src='/a.png', alt='A'}))
	as(htm == '<img alt="A" src="/a.png">')  -- using table as attr; names emitted sorted

	-- error: void element cannot have children
	as(pcall(v, -> return hr(hr())) == false)
	as(pcall(v, -> return hr({div(), span()})) == false)


	-- normal element
	as(v(-> return div()) == '<div></div>')
	as(v(-> return div("foo")) == '<div>foo</div>')  -- by default, args are children
	-- if 2nd arg exists, and 1st arg is a str or a tbl with key/val (except key '_tag'), then 1st arg is attr
	as(v(-> return div(".foo", '')) == '<div class="foo"></div>')
	-- invalid attr
	as(pcall(v, -> return div("   .foo", '')) == false)
	as(v(-> return div("#id1.foo", '')) == '<div class="foo" id="id1"></div>')  -- #str is id, .str is class
	as(v(-> return div("[class=foo][title=bar]", {})) == '<div class="foo" title="bar"></div>') -- or str of boxed [key=value] list
	as(v(-> return div("[id=id1][title='bar']", "x")) == '<div id="id1" title="bar">x</div>')  -- quotes in boxed attr are optional
	as(v(-> return div("[title=\"bar\"]", 1)) == '<div title="bar">1</div>')  -- children can take number or str

	as(v(-> return p(h1("blog"))) == '<p><h1>blog</h1></p>')  -- child can be a single element

	as(v(-> return nav(span('z'), span(1), span(false))) == '<nav><span>z</span><span>1</span><span>false</span></nav>') -- children can be args
	as(v(-> return p({"AA", mark("mk")}, "YY", "ZZ")) == '<p>AA<mark>mk</mark>YYZZ</p>') -- children can be args
	as(v(-> return p({"AA", mark("mk"), "ZZ"})) == '<p>AA<mark>mk</mark>ZZ</p>') -- children can be an array
	as(v(-> return ul({ li("item1"), li("item2")})) == '<ul><li>item1</li><li>item2</li></ul>') -- children can be an array
	as(v(-> return a({href = "/"}, strong(nil, "Home"))) == '<a href="/"><strong>Home</strong></a>')

	as(v(-> return {img("[src=/img/tmp file.png]"), span("span1")}) == '<img src="/img/tmp file.png"><span>span1</span>') -- view function can return a list
	as(v(-> return {"AAA", "bbb", p("para")}) == 'AAAbbb<p>para</p>')  -- list with plain string too

	-- `table` and `select` are html tags in a template, not the lua libraries
	as(v(-> return table({tr({td("x")})})) == '<table><tr><td>x</td></tr></table>')
	as(v(-> return select({option("a")})) == '<select><option>a</option></select>')

	print('pass')


test()

var pgmoon = require('pgmoon')
var parrays = require('pgmoon.arrays')  -- encode_array()  cannot handle empty array and array of row types
var pjson = require('pgmoon.json')
var phstore = require('pgmoon.hstore')
var sql = require('losty.sql.base')
var str_gsub = string.gsub

-- Only tables made by K.raw() carry this metatable, so JSON-decoded input
-- (which cannot set a metatable) can never smuggle verbatim SQL
var RAW = {}

-- Remember to call setup_hstore()

var escape = {
	literal = \val ->
		if val == nil or val == ngx.null
			return "NULL"

		var ty = type(val)
		if 'number' == ty or 'boolean' == ty
			return tostring(val)
		else if 'string' == ty
			return "'" .. str_gsub(val, "'", "''") .. "'"
		return nil, "cannot escape literal " .. tostring(val)

	, identifier = \val ->
		if 'string' == type(val)
			return '"' .. str_gsub(val, '"', '""') .. '"'
		return nil, "cannot escape identifier " .. tostring(val)

	-- verbatim SQL, only ever produced by K.raw(): transform comments and strip
	-- ';' so a wrapped fragment cannot smuggle a second statement
	, raw = \val ->
		if 'string' ~= type(val)
			return nil, "raw SQL must be a string"
		var s = str_gsub(val, "/%*", "/ *")
		s = str_gsub(s, "%*/", "* /")
		s = str_gsub(s, "%-%-", "- -")
		return str_gsub(s, ";", "")

}


return \database, user, password, host, port, pool, dbg ->

	var db = pgmoon.new({database = database, user = user, password = password, host = host, port = port, pool = pool})
	-- nil works better in conditional expr
	--db.convert_null = true
	--db.NULL = ngx.null


	-- make composite value, probably inside array like ARRAY['(,,"",)', '(,,,"")']
	-- https://www.postgresql.org/docs/11/rowtypes.html
	-- https://www.postgresql.org/docs/11/sql-expressions.html#SQL-SYNTAX-ROW-CONSTRUCTORS
	var encode_row
	encode_row = \t ->
		var out = {}
		for i, v in ipairs(t)
			var o
			if v == ngx.null
				o = ''  -- null is bare
			else
				var ty = type(v)
				if 'table' == ty
					o = encode_row(v)
				else if 'string' == ty
					if 0 == string.len(v)
						o = '""'
					else
						o = str_gsub(v, ",", "\\,")
				else
					o = tostring(v) or ''
			out[i] = o
		return "(" .. table.concat(out, ",") .. ")"


	-- mode must be a char
	var encode = \mode, v ->
		if v == nil or v == ngx.null
			return "NULL"

		-- verbatim SQL: only ever produced by K.raw(), never from user data
		if getmetatable(v) == RAW
			return escape.raw(v[1])

		var ty = type(v)
		if 'table' == ty
			if mode == 'r'
				return encode_row(v)   -- escape.literal(encode_row(v))
			else if mode == 'a'
				return parrays.encode_array(v)
			else if mode == 'h'
				return phstore.encode_hstore(v)
			else if mode == '?'
				return pjson.encode_json(v)

		else if 'number' == ty or 'string' == ty or 'boolean' == ty
			if mode == 'b'
				return db.encode_bytea(@, v)
			else if mode == '?'
				return escape.literal(v)
			else if mode == 'i'
				return escape.identifier(v)

		return nil, "invalid placeholder `:" .. mode .. "` for a " .. ty


	-- To list all pgsql operators
	-- psql
	-- \do ?
	-- \do ??
	-- \do ???
	-- why not named parameter :var: inside query ? coz lauzy can no longer check use of undeclared variable
	-- Only nil, boolean, number, string and table acceptable as arguments for placeholder

	-- position just past a quoted string/identifier (pos is the opening quote);
	-- doubled quotes ('' / "") are skipped, plus backslash escapes when bs is set
	var skip_quote = \query, pos, q, bs ->
		var i, len = pos + 1, #query
		while i <= len
			var ch = string.sub(query, i, i)
			if bs and '\\' == ch
				i = i + 2
			else if q == ch
				if q == string.sub(query, i + 1, i + 1)
					i = i + 2
				else
					return i + 1
			else
				i = i + 1
		return len + 1

	-- SQL-aware scan: strings, quoted identifiers, dollar-quoted bodies and
	-- comments are copied verbatim, so `!?` inside a literal like 'wow!bar' is
	-- not a placeholder; `!`+mode is only recognized in normal context. Casts
	-- (::type) are plain SQL and need no special case
	var interpolate = \query, ... ->
		var args = {...}
		var i = 0
		var bad  -- first failed placeholder, if any
		var buf, n = {}, 0
		var pos, len = 1, #query
		var push = \s ->
			n = n + 1
			buf[n] = s

		while pos <= len
			var ch = string.sub(query, pos, pos)
			var ch2 = string.sub(query, pos + 1, pos + 1)

			if "'" == ch or '"' == ch
				-- E'...' / e'...' treat backslash as an escape
				var bs = false
				if "'" == ch and pos > 1
					var p = string.sub(query, pos - 1, pos - 1)
					if 'E' == p or 'e' == p
						bs = true
				var stop = skip_quote(query, pos, ch, bs)
				push(string.sub(query, pos, stop - 1))
				pos = stop

			else if '-' == ch and '-' == ch2
				var e = string.find(query, "\n", pos, true) or (len + 1)
				push(string.sub(query, pos, e - 1))
				pos = e

			else if '/' == ch and '*' == ch2
				var depth, e = 1, pos + 2
				while depth > 0 and e <= len
					if '/*' == string.sub(query, e, e + 1)
						depth = depth + 1
						e = e + 2
					else if '*/' == string.sub(query, e, e + 1)
						depth = depth - 1
						e = e + 2
					else
						e = e + 1
				push(string.sub(query, pos, e - 1))
				pos = e

			else if '$' == ch
				var tag = string.match(query, "^%$[%a_][%w_]*%$", pos)
				if not tag and '$$' == string.sub(query, pos, pos + 1)
					tag = '$$'
				if tag
					var e = string.find(query, tag, pos + #tag, true)
					var stop = e and (e + #tag) or (len + 1)
					push(string.sub(query, pos, stop - 1))
					pos = stop
				else
					push(ch)
					pos = pos + 1

			else if '!' == ch
				var mode = string.match(query, "^!([a-z%?])", pos)
				if mode
					i = i + 1
					var s, err = encode(mode, args[i])
					if s
						push(s)
					else if not bad
						bad = tostring(err) .. " at position " .. i
					pos = pos + 2
				else
					push(ch)
					pos = pos + 1

			else
				push(ch)
				pos = pos + 1

		return table.concat(buf), i, bad


	-- on success err is the number of queries run (0 when the script is only
	-- comments), so anything else is a failure
	var is_error = \err ->
		return err ~= nil and not tonumber(err)

	-- log the reason always; the query (and caller) may embed secrets/PII, so
	-- keep them behind the verbose dbg flag to avoid leaking data and log spam
	var log_error = \q, err ->
		ngx.log(ngx.ERR, err)
		if dbg
			ngx.log(ngx.ERR, q)
			ngx.log(ngx.ERR, debug.traceback('', 3))

	-- every statement goes through here, so that none escapes the logging above
	var exec = \q ->
		if dbg
			--ngx.log(ngx.NOTICE, q)  -- this one does not show on screen
			print(q)

		var result, err, partial, count = db.query(@, q)
		if is_error(err)
			log_error(q, err)
		return result, err, partial, count

	var run = \str, ... ->
		var n = select("#", ...)
		var q, i, bad = interpolate(str, ...)
		if bad
			ngx.log(ngx.ERR, bad)
			return nil, bad
		if n ~= i
			-- do not run: a missing argument would silently bind as NULL
			var msg = "trying to match " .. i .. " placeholders to " .. n .. " arguments for query `" .. str .. "`"
			ngx.log(ngx.ERR, msg)
			return nil, msg

		return exec(q)

	var keepalive = \timeout ->
		db.keepalive(@, timeout)

	var K = sql(db, run)

	K.encode = encode

	-- wrap a trusted SQL fragment so it can be spliced verbatim as a placeholder:
	--   q.s("... created_at > !?", q.raw("now() - interval '1 day'"))
	K.raw = \fragment ->
		return setmetatable({fragment}, RAW)

	K.hstore = ->
		db.setup_hstore(@)

	-- returns variadic arguments that are interpolated
	-- eg: variadic("!?", 'a', 'b', 'c') gives a string "'a', 'b', 'c'"
	K.variadic = \mode, ... ->
		var n = select("#", ...)
		if n > 0
			var places = string.rep(", " .. mode, n - 1)
			return (interpolate(mode .. places, ...))  -- () parenthesis to remove other returns


	-- must only connect() inside a function, not at top level
	-- else Error: cannot yield across C-call boundary
	K.connect = ->
		var ok, err = db.connect(@)
		if not ok
			-- assert() alone would drop the reason, eg: connection refused
			log_error('CONNECT', err)
			error(tostring(err), 2)
		return ok

	-- closes the connection, vs disconnect() which keepalive the connection and rollback uncommitted transaction
	K.close = ->
		db.disconnect(@)

	-- if read timed out, pgmoon closes the socket for us
	-- no need to wrap in xpcall()
	K.listen = ->
		return db.wait_for_notification(@)

	K.subscribe = \channel ->
		return exec('LISTEN ' .. channel)

	K.unsubscribe = \channel ->
		return exec('UNLISTEN ' .. channel)


	var tx = 0
	var sp_name = ->
		var id = ngx.worker.pid()
		return 'SP' .. tx .. '_' .. id

	-- timeout = 0 means wont timeout in the pool
	K.disconnect = \timeout ->
		if tx > 0
			-- must not be silently dropped: the open transaction is discarded
			exec('ROLLBACK')
			tx = 0
		keepalive(timeout)

	K.begin = \serializable ->
		var cmd
		if tx < 1
			if serializable == true
				cmd = 'BEGIN ISOLATION LEVEL SERIALIZABLE'
			else if serializable == false
				cmd = 'BEGIN ISOLATION LEVEL REPEATABLE READ'
			else
				cmd = 'BEGIN'
		else
			cmd = 'SAVEPOINT ' .. sp_name()
		tx = tx + 1
		return exec(cmd)

	K.commit = ->
		assert(tx > 0, "no transaction or savepoint to commit")
		tx = tx - 1
		var cmd = tx < 1 and 'COMMIT' or 'RELEASE SAVEPOINT ' .. sp_name()
		return exec(cmd)


	K.rollback = ->
		assert(tx > 0, "no transaction or savepoint to rollback")
		tx = tx - 1
		var cmd = tx < 1 and 'ROLLBACK' or 'ROLLBACK TO SAVEPOINT ' .. sp_name()
		return exec(cmd)

	return K


var concat = table.concat
var ngx_header = ngx.header
var hdr = require('losty.header')
var insert = hdr.insert

return ->
	var hosts = {}
	var headers = {}
	var methods = {}
	var expose_headers = {}
	var max_age = 3600
	var credentials = true

	var K = {}
	K.host = \host ->
		insert(hosts, host)

	K.method = \method->
		insert(methods, method)

	K.header = \header ->
		insert(headers, header)

	K.expose_header = \header ->
		insert(expose_headers, header)

	K.max_age = \age ->
		max_age = age

	K.credentials = \cred ->
		credentials = cred

	-- middleware: set the CORS headers, then continue the chain. works as the
	-- last handler too (req.next() returns nothing when there is no next)
	K.run = \req, res ->
		var origin = req.headers["Origin"]
		if not origin
			return req.next()

		-- the response differs by Origin even when the origin is rejected, so
		-- caches must key on it
		res.vary("Origin")

		var allowed = false
		for _, v in ipairs(hosts)
			-- match the whole Origin: else "example%.com" would also allow
			-- "evil-example.com" and "example.com.attacker.net"
			if ngx.re.find(origin, "^" .. v .. "$", "jo")
				allowed = true
				break

		if not allowed
			return req.next()

		ngx_header["Access-Control-Allow-Origin"] = origin
		ngx_header["Access-Control-Expose-Headers"] = concat(expose_headers, ",")
		-- "false" is the default, so only send the header when it is needed
		if credentials
			ngx_header["Access-Control-Allow-Credentials"] = "true"
		-- preflight only
		if 'OPTIONS' == req.vars.request_method
			ngx_header["Access-Control-Max-Age"] = max_age
			ngx_header["Access-Control-Allow-Headers"] = concat(headers, ",")
			ngx_header["Access-Control-Allow-Methods"] = concat(methods, ",")

		return req.next()

	return K



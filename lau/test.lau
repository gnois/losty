-- pgmoon writes a global `lpeg`, which trips OpenResty's _G write guard:
--   _G write guard:12: writing a global lua variable ('lpeg') which may lead to
--   race conditions between concurrent requests, so prefer the use of 'local' variables
-- Let only that one name through and keep the guard for everything else, so real
-- accidental globals (the ones that actually race) are still reported while testing.
var mt = getmetatable(_G)
if mt and mt.__newindex
	var guard = mt.__newindex
	mt.__newindex = \t, n, v ->
		if 'lpeg' == n
			return rawset(t, n, v)
		return guard(t, n, v)

var c = require('losty.shell')
var tbl = require('losty.tbl')

-- dump value into string, used by chk()
var s = \... ->
	var args = {...}
	var n = select("#", ...)
	var out = {}
	for i = 1, n
		var x = args[i]
		if x == nil
			out[i] = "<nil>"
		else if x == ngx.null
			out[i] = "<ngx.null>"
		else if type(x) == 'table'
			out[i] = tbl.dump(x)
		else
			out[i] = tostring(x)
	return table.concat(out, ' ')

-- make short key names for db access
var setup = \db ->
	if db
		var map = {
			s = "select"
			, i = "insert"
			, u = "update"
			, d = "delete"
		}
		var q = db
		-- add shorter function names
		for k, v in pairs(map)
			q[k] = db[v]
			q[k..'1'] = db[v..'1']
		return q



-- db can be nil if not using sql
return \db, func, continue_on_err ->  -- by default, stops testing on error or chk() failed

	var q = setup(db)

	-- shorthand to print value
	var prn = \... -> print(s(...))

	var checks = 0
	var fails = 0
	var errors = 0
	-- works like assert, but not terminating
	-- fits nicely with functions returning nil, err
	var chk = \ok, ... ->
		checks = checks + 1
		if ok
			print(c.bright .. c.green .. "ok" .. c.reset)
		else
			fails = fails + 1
			print(c.bright .. c.red .. "fail: " .. s(...) .. c.reset)

	var groups = 0
	var passes = 0
	var params = {}  -- as scratch table for passing data among tests

	var test = \desc, fn, rollback ->  -- wrap test in a savepoint, always rolled back
		if not continue_on_err and (errors > 0 or fails > 0)
			return

		groups = groups + 1
		checks = 0
		fails = 0
		errors = 0

		var title = c.bright .. c.cyan .. groups .. ". " .. c.yellow .. "[[ " .. (desc or "?? no name ??") .. " ]]"
		if rollback
			title = title .. c.cyan .. " - WITH ROLLBACK"
		print("                                         " .. title .. c.reset)
		if q and rollback
			q.begin()
		-- use an explicit flag instead of xpcall's return shape: Lua 5.1/JIT and
		-- Lua 5.2 disagree on whether xpcall forwards args / returns a status
		var failed
		var trace
		var run = -> return fn(params)
		xpcall(run, \e ->
			failed = true
			trace = debug.traceback(e, 2)
			return trace
		)
		if failed
			if q and rollback
				q.rollback()
			print(c.bright .. c.red, "\nERROR: " .. s(trace) .. "\n" .. c.reset)
			errors = errors + 1
		else
			if q and rollback
				-- testing: always undo the test's savepoint so it cannot pollute the db
				q.rollback()

		if fails == 0 and errors == 0
			passes = passes + 1

		var msg = checks .. " checks: " .. checks - fails .. " passed"
		if fails > 0
			msg = msg .. ", " .. fails .. " failed"
		if errors > 0
			msg = msg .. "   [ Error: " .. errors .. " ]"

		var color = fails + errors > 0 and c.cyan or c.green
		print(c.bright .. color .. "                                         ---------- " .. msg .. " ----------\n" .. c.reset)


	if q q.connect()
	-- always disconnect, even if func raises, so the pooled connection is returned
	-- instead of being leaked for the rest of the process
	var trace
	var run = -> return func(test, chk, prn, q)
	xpcall(run, \e ->
		trace = debug.traceback(e, 2)
		return trace
	)
	if q q.disconnect()
	if trace
		error(trace, 0)

	var color = groups - passes > 0 and c.magenta or c.yellow
	print(c.bright .. color .. '                                         === ' .. groups .. " cases:    " .. passes .. " ok,    " .. groups - passes .. " not ok ===\n" .. c.reset)

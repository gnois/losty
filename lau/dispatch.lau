
var dispatch = \hn, q, r, ... ->
	var i, n = 0, #hn
	var nargs, aargs = 0

	-- middleware must call nxt(), NOT nxt(...) else is re-appending the payload
	var nxt
	nxt = \... ->
		i = i + 1
		if i <= n
			var np = select('#', ...) -- select() counts nils in ...
			if np > 0
				aargs = aargs or {}
				for j = 1, np
					aargs[nargs + j] = select(j, ...)
				nargs = nargs + np

			if aargs
				-- unpack() accepts tables of up to 8000 elements only in Lua 5.1 and LuaJIT
				return hn[i](q, r, nxt, unpack(aargs, 1, nargs)) -- preserve all nils
			return hn[i](q, r, nxt)

	return nxt(...)


return dispatch

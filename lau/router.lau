--``
We use only url chars that has meaning or unsafe: /, ?, #, :
plus {} for route syntax, since braces are not valid url chars

Description:
Router must be deterministic, and shd check for most errors during registration

Precedence when multiple possible matches
1. Exact literal match
2. Pattern match, by order of registration
3. Wildcard ({*}), last

Route grammar (a segment is a literal, or a {...} token)
  {name}          named capture, one segment (default pattern [^/]+)
  {name:%d+}      named capture with an explicit lua pattern
  {:%d+}          positional capture with an explicit lua pattern
  {*}  {*name}    wildcard: the rest of the path (>=1 segment); last segment only
  {+}             prefix middleware: wraps this node and its descendants; last only

A pattern cannot contain %c, %s, and obviously /, which is always a path separator, nor { }.
The whole segment is captured; an outermost ( ) around the pattern is redundant.

Named captures are collected into q.params (nil when none were bound); positional
ones (and the whole segment of a named one) remain in the q.match array. A pattern
node is shared by pattern text, so every name given to it is bound to the same
captured segment.

There is no way to specify an optional last segment, to avoid possible conflicts
  /page/{:?}  <-
  /page
specify both routes instead, with and without the optional segment

--``


var str_sub = string.sub
var str_find = string.find
var str_match = string.match

var next_segment = \path ->
	if not path or path == '' or path == '/'
		return nil, ''

	var n = #path
	var i = 1
	while i <= n and str_sub(path, i, i) == '/'
		i = i + 1
	if i > n
		return nil, ''

	var j = i
	while j <= n and str_sub(path, j, j) ~= '/'
		j = j + 1
	if j <= n
		return str_sub(path, i, j - 1), str_sub(path, j)
	return str_sub(path, i), ''

-- route grammar: a segment is either a literal, or a {...} token. '{' and '}' are
-- not valid url path characters, so they can never appear in a real request: that
-- is what makes the grammar unambiguous.
--   {name}          named capture, one segment (default pattern [^/]+)
--   {name:%d+}      named capture with an explicit lua pattern
--   {:%d+}          positional capture with an explicit lua pattern
--   {*}  {*name}    wildcard: the rest of the path (>=1 segment); last segment only
--   {+}             prefix middleware; wraps this node and all descendants; last only
var NAME = "^[%a_][%w_]*$"
-- canonical order for the Allow header (HEAD follows GET; not a registerable verb)
var ALLOW_ORDER = {'GET', 'HEAD', 'POST', 'PUT', 'DELETE', 'PATCH', 'OPTIONS'}

-- a node holds literal children (kids), pattern children (pats), an optional
-- wildcard child, terminal handlers (leaf) and prefix middleware handlers (mw)
var new_node = ->
	return {kids = {}, pats = {}}

-- trim a sequence back to len entries, undoing a failed match branch
var truncate = \t, len ->
	for i = #t, len + 1, -1
		t[i] = nil

var router = ->
	var tree = {}
	-- per-method capability flags, so match() can skip allocating the capture and
	-- middleware scratch tables for methods that have neither
	var has_mw = {}
	var has_name = {}

	var bind = \matches, m, token, toklen, names, caps, s, e, ... ->
		if s == 1 and e == toklen
			matches[m] = token
			if names
				for _, nm in ipairs(names)
					caps[#caps + 1] = {nm, token}
			m = m + 1
			var n = select('#', ...)
			for i = 1, n
				var v = select(i, ...)
				if v == nil
					break
				matches[m] = v
				m = m + 1
			return true, m
		return false, m

	-- collects prefix middleware (mws) and named captures (caps) along the winning
	-- path; both are trimmed on backtrack, like the capture index m. caps and mws
	-- are nil when the method has no named captures / no middleware at all.
	let resolve = \path, node, matches, m, caps, mws ->
		if node.mw
			for _, f in ipairs(node.mw)
				mws[#mws + 1] = f
		-- keepmw is taken *after* this node's middleware: a failed child branch
		-- must drop only what it added, not what this node contributed
		var keepmw = mws and #mws or 0
		var keepcap = caps and #caps or 0

		var token
		token, path = next_segment(path)
		if not token
			return node.leaf, m

		-- exact match
		var child = node.kids[token]
		if child
			var leaf, em = resolve(path, child, matches, m, caps, mws)
			if leaf
				return leaf, em
			if mws truncate(mws, keepmw)
			if caps truncate(caps, keepcap)

		-- pattern match, by order of registration
		var toklen = #token
		for _, e in ipairs(node.pats)
			-- save state in case of backtrack
			var prev = m
			var c0 = caps and #caps or 0
			var ok
			ok, m = bind(matches, m, token, toklen, e.names, caps, str_find(token, e.pat))
			if ok
				var leaf, pm = resolve(path, e.node, matches, m, caps, mws)
				if leaf
					return leaf, pm
			m = prev
			if caps truncate(caps, c0)
			if mws truncate(mws, keepmw)

		-- wildcard: bind the rest of the path
		if node.wild
			var rest = token .. path
			matches[m] = rest
			if node.wild.name
				caps[#caps + 1] = {node.wild.name, rest}
			if node.wild.leaf
				return node.wild.leaf, m + 1
			matches[m] = nil
			if caps truncate(caps, keepcap)
		return false


	var check = \pattern ->
		if not str_find(pattern, '[%.%%]') and not str_find(pattern, '%b[]')
			return false, "'" .. pattern .. "' is not a pattern"

		if str_find(pattern, '[:#]')
			return false, "'" .. pattern .. "' may not match any url"

		for _, c in ipairs({'%%c', '%%s'})
			if str_find(pattern, c)
				return false, "'" .. str_sub(c, 2) .. "' may not match any url"

		-- let lua check malformed pattern
		return pcall(str_find, pattern, pattern)


	-- remove the outermost capturing parenthesis: the whole segment is captured
	-- anyway, so wrapping the pattern in ( ) is redundant (historically allowed)
	var strip = \pat ->
		if str_match(pat, "%b()") == pat
			return str_sub(pat, 2, -2)
		return pat

	-- pattern children are shared by pattern text, so a route and a prefix
	-- middleware on the same pattern land on the same node. every name given to
	-- the shared pattern is bound to the captured segment.
	var find_pat = \node, pat, name ->
		for _, e in ipairs(node.pats)
			if e.pat == pat
				if name
					e.names = e.names or {}
					var found
					for _, nm in ipairs(e.names)
						if nm == name
							found = true
							break
					if not found
						e.names[#e.names + 1] = name
				return e.node
		var names
		if name
			names = {name}
		node.pats[#node.pats + 1] = {pat = pat, names = names, node = new_node()}
		return node.pats[#node.pats].node

	-- classify one path segment into a descriptor, or fail loudly
	var segment = \token, path ->
		if str_sub(token, 1, 1) == '{'
			if str_sub(token, -1) ~= '}'
				error("route '" .. path .. "': unbalanced '{' in '" .. token .. "'", 4)
			var inner = str_sub(token, 2, -2)
			if str_find(inner, '[{}]')
				error("route '" .. path .. "': unexpected brace in '" .. token .. "'", 4)
			if inner == '+'
				return {kind = 'mw'}
			if str_sub(inner, 1, 1) == '*'
				var wname = str_sub(inner, 2)
				if wname ~= '' and not str_match(wname, NAME)
					error("route '" .. path .. "': bad wildcard name '" .. token .. "'", 4)
				return {kind = 'wild', name = wname ~= '' and wname or nil}
			if str_sub(inner, 1, 1) == ':'
				var pat = strip(str_sub(inner, 2))
				var ok, err = check(pat)
				if not ok
					error(err .. " in " .. path, 4)
				return {kind = 'cap', pat = pat}
			var c = str_find(inner, ':', 1, true)
			var nm, ptn
			if c
				nm = str_sub(inner, 1, c - 1)
				ptn = strip(str_sub(inner, c + 1))
			else
				nm = inner
				ptn = '[^/]+'
			if not str_match(nm, NAME)
				error("route '" .. path .. "': '" .. token .. "' is neither a name nor ':{pattern}'", 4)
			var okp, errp = check(ptn)
			if not okp
				error(errp .. " in " .. path, 4)
			return {kind = 'cap', pat = ptn, name = nm}
		-- literal
		if str_sub(token, 1, 1) == ':'
			error("route '" .. path .. "': patterns moved into braces: write '{:" .. str_sub(token, 2) .. "}'", 4)
		if str_find(token, '%*')
			error("route '" .. path .. "': '*' is not a route marker: use '{*}' or '{+}'", 4)
		if str_find(token, '[{}]')
			error("route '" .. path .. "': unexpected brace in '" .. token .. "'", 4)
		return {kind = 'lit', token = token}

	var parse = \path ->
		var segs = {}
		for token in string.gmatch(path, "[^/]+")
			segs[#segs + 1] = segment(token, path)
		return segs

	var build = \root, segs, path, ... ->
		var node = root
		var n = #segs
		for i = 1, n
			var seg = segs[i]
			if seg.kind == 'mw'
				if i ~= n
					error("route '" .. path .. "': '{+}' must be the last segment", 4)
				node.mw = node.mw or {}
				for _, f in ipairs({...})
					node.mw[#node.mw + 1] = f
				return
			if seg.kind == 'wild'
				if i ~= n
					error("route '" .. path .. "': '{*}' must be the last segment", 4)
				node.wild = node.wild or new_node()
				if seg.name
					if node.wild.name and node.wild.name ~= seg.name
						error("route '" .. path .. "': wildcard already named '" .. node.wild.name .. "'", 4)
					node.wild.name = seg.name
				node = node.wild
			else if seg.kind == 'cap'
				node = find_pat(node, seg.pat, seg.name)
			else
				node.kids[seg.token] = node.kids[seg.token] or new_node()
				node = node.kids[seg.token]

		node.leaf = node.leaf or {}
		for _, f in ipairs({...})
			node.leaf[#node.leaf + 1] = f


	var invalid = \path ->
		if not path or #path < 1
			return "is empty"
		if str_sub(path, 1, 1) ~= '/'
			return "does not start with '/'"
		if str_find(path, '%s')
			return "has space"
		if str_find(path, '//')
			return "has empty segment"


	return {
		match = \method, path, strict ->
			var nodes = tree[method]
			if not nodes
				return nil, "unmatched method: " .. (method or "")
			if strict and str_find(path, '//')
				return nil, "disallowed double slash path: " .. (path or "")
			-- remove query string
			path = path or ""
			var q = str_find(path, "?", 1, true)
			if q
				path = str_sub(path, 1, q - 1)
			-- allocate the scratch tables only when this method can use them
			var matches = {}
			var caps
			if has_name[method]
				caps = {}
			var mws
			if has_mw[method]
				mws = {}
			var leaf, m = resolve(path, nodes, matches, 1, caps, mws)
			if not leaf
				return nil, "unmatched path: " .. (path or "")
			truncate(matches, m)
			var params
			if caps and #caps > 0
				params = {}
				for _, c in ipairs(caps)
					params[c[1]] = c[2]
			if not mws or #mws == 0
				return leaf, matches, params
			-- compose prefix middleware in front of the terminal handlers.
			-- build a new array: never mutate the stored leaf
			var handlers = {}
			for _, f in ipairs(mws)
				handlers[#handlers + 1] = f
			for _, f in ipairs(leaf)
				handlers[#handlers + 1] = f
			return handlers, matches, params

		, allowed = \method, path ->
			-- `match` already returned nothing for this method. return the methods
			-- the path *is* registered under (HEAD implied by GET), in canonical
			-- order, or nil when the path matches no method at all (a true 404).
			path = path or ""
			var q = str_find(path, "?", 1, true)
			if q
				path = str_sub(path, 1, q - 1)
			var primary = tree[method]
			var set = {}
			for meth, nodes in pairs(tree)
				if nodes ~= primary and resolve(path, nodes, {}, 1, {}, {})
					set[meth] = true
					if meth == 'GET'
						set["HEAD"] = true
			if next(set) == nil
				return nil
			var arr = {}
			for _, m in ipairs(ALLOW_ORDER)
				if set[m]
					table.insert(arr, m)
			return arr

		, set = \method, path, ... ->
			var err = invalid(path)
			if err
				error("route '" .. path .. "' " .. err, 4)
			if not tree[method]
				tree[method] = new_node()
			var segs = parse(path)
			for _, seg in ipairs(segs)
				if seg.kind == 'mw'
					has_mw[method] = true
				else if seg.name
					-- a named segment: {name}, {name:%d+} or {*name}
					has_name[method] = true
			build(tree[method], segs, path, ...)
			return tree[method]
	}



return router
